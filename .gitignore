# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/

# Environment and secrets
.env
.env.*
!.env.example
*.env
!*.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials.json

# Runtime data: the SQLite database, uploads and scratch files.
# data/config.ocio is the one tracked file in data/.
data/*
!data/config.ocio
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
backups/
*.bundle

# Local tool and editor settings
.claude/
.codex/
.vscode/
.idea/
.DS_Store

# Logs and caches
*.log
*.tmp
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/
