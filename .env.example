# ============================================================================
# TasksBot Configuration
# ============================================================================

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
DEADLINE_API_URL=https://renderfarm.local:4434/api
DEADLINE_TLS_VERIFY=False

# ----------------------------------------------------------------------------
# Telegram
# ----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# ----------------------------------------------------------------------------
# Dropbox
# ----------------------------------------------------------------------------
DROPBOX_APP_KEY=YOUR_DROPBOX_APP_KEY
DROPBOX_APP_SECRET=YOUR_DROPBOX_APP_SECRET
DROPBOX_REFRESH_TOKEN=YOUR_DROPBOX_REFRESH_TOKEN
DROPBOX_TEAM_MEMBER_ID=YOUR_DROPBOX_TEAM_MEMBER_ID
DROPBOX_ROOT_NAMESPACE_ID=YOUR_DROPBOX_ROOT_NAMESPACE_ID
DROPBOX_ROOT_MARKER=Team Folder

# ----------------------------------------------------------------------------
# Storage
# ----------------------------------------------------------------------------
SQLITE_DB_PATH=data/app.db
TEMP_DIR=data/temp
CONV_DIR=data/conv
OCIO_CONFIG_PATH=data/config.ocio
FFMPEG_PATH=ffmpeg

# ----------------------------------------------------------------------------
# Preview Rendering
# ----------------------------------------------------------------------------
PREVIEW_APPLY_COLOR_TRANSFORM=True
PREVIEW_INPUT_SPACE=ACEScg
PREVIEW_DISPLAY=sRGB
PREVIEW_VIEW=ACES 1.0 SDR-video
PREVIEW_LUT_SIZE=65
PREVIEW_OCIO_REMOTE_CONFIG=auto
PREVIEW_ATTACH_OCIO_CONFIG=False
PREVIEW_PYTHON_EXECUTABLE=python
PREVIEW_TEMP_DIR=auto
PREVIEW_COLOR_MODE=lut

# ----------------------------------------------------------------------------
# Preview Upload (Worker -> Bot)
# ----------------------------------------------------------------------------
PREVIEW_UPLOAD_ENABLED=False
PREVIEW_UPLOAD_URL=http://your-public-ip:8081/preview-upload
PREVIEW_UPLOAD_BIND_HOST=0.0.0.0
PREVIEW_UPLOAD_PORT=8081
PREVIEW_UPLOAD_TOKEN_TTL=43200
PREVIEW_UPLOAD_MAX_MB=100
PREVIEW_UPLOAD_INSECURE=False

# Job monitoring intervals (seconds)
JOB_WATCHER_INTERVAL_NORMAL=60
JOB_WATCHER_INTERVAL_PREVIEW=5

# ----------------------------------------------------------------------------
# Security
# ----------------------------------------------------------------------------
ENCRYPTION_KEY=YOUR_FERNET_ENCRYPTION_KEY
