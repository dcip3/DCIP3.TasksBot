# Application settings
APP_DOMAIN=example.com
BASE_API_URL=https://renderfarm.local:8443/api
HTTP_TIMEOUT=30

# Telegram settings
TG_API_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Dropbox settings
DROPBOX_APP_KEY=YOUR_DROPBOX_APP_KEY
DROPBOX_APP_SECRET=YOUR_DROPBOX_APP_SECRET
DROPBOX_REFRESH_TOKEN=YOUR_DROPBOX_REFRESH_TOKEN
DROPBOX_TEAM_MEMBER_ID=YOUR_DROPBOX_TEAM_MEMBER_ID
DROPBOX_ROOT_NAMESPACE_ID=YOUR_DROPBOX_ROOT_NAMESPACE_ID
DROPBOX_ROOT_MARKER=YOUR_DROPBOX_ROOT_MARKER

# Storage paths
DB_PATH=storage/tasks_bot.db
CREDENTIALS_FILE=credentials.json
TEMP_DIR=storage/temp
CONV_DIR=storage/conv
OCIO_CONFIG_PATH=storage/config.ocio
FFMPEG_PATH=ffmpeg  # Полный путь к ffmpeg на рабочих узлах (при необходимости)

# Download and worker limits
MAX_CONCURRENT_DOWNLOADS=2
MIN_FREE_SPACE_BYTES=10737418240

# Security
PASSWORD_SALT=change_me_to_secure_random
