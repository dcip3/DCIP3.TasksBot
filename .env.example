# ============================================================================
# TasksBot Configuration
#
# Only required credentials and deployment-specific options are listed here.
# Every other setting has a sensible default — see app/core/config.py for the
# full list (env var name = field name in UPPERCASE).
# ============================================================================

# --- Required ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
DEADLINE_API_URL=https://renderfarm.local:4434/api

# Fernet key for encrypting stored passwords (generate with Fernet.generate_key())
ENCRYPTION_KEY=YOUR_FERNET_ENCRYPTION_KEY

# --- Deployment-specific ----------------------------------------------------
# Set to False when the farm uses a self-signed certificate.
DEADLINE_TLS_VERIFY=True

# 'lut' (single ffmpeg pass) or 'cpu' (OCIO on CPU; needed when ffmpeg cannot
# decode the render EXRs, e.g. DWAA-compressed).
PREVIEW_COLOR_MODE=lut

# OCIO config path as seen from Deadline workers (leave empty to disable).
PREVIEW_OCIO_REMOTE_CONFIG=

# Worker -> bot preview upload endpoint (must be reachable from workers).
PREVIEW_UPLOAD_ENABLED=False
PREVIEW_UPLOAD_URL=http://your-public-ip:8081/preview-upload
