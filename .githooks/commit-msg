#!/usr/bin/env bash
set -euo pipefail
msg_file="$1"
if python3 - "$msg_file" <<'PY'
import sys
from pathlib import Path

text = Path(sys.argv[1]).read_text(encoding="utf-8", errors="ignore")
for ch in text:
    code = ord(ch)
    if (
        0x0400 <= code <= 0x04FF  # Cyrillic
        or 0x0500 <= code <= 0x052F  # Cyrillic Supplement
        or 0x2DE0 <= code <= 0x2DFF  # Cyrillic Extended-A
        or 0xA640 <= code <= 0xA69F  # Cyrillic Extended-B
        or 0x1C80 <= code <= 0x1C8F  # Cyrillic Extended-C
    ):
        sys.exit(1)
sys.exit(0)
PY
then
  :
else
  echo "Commit message contains Cyrillic. Use English only." >&2
  exit 1
fi
