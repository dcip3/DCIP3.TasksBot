#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
if command -v py >/dev/null 2>&1; then
  exec py -3 "$root/scripts/check_commit_messages.py" --file "$1"
elif command -v python3 >/dev/null 2>&1; then
  exec python3 "$root/scripts/check_commit_messages.py" --file "$1"
else
  exec python "$root/scripts/check_commit_messages.py" --file "$1"
fi
