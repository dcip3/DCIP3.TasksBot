#!/usr/bin/env bash
set -euo pipefail

msg_file="${1:?Path to commit message is required}"

# Remove git comments and blank lines before validation.
message="$(sed -E '/^[[:space:]]*#/d;/^[[:space:]]*$/d' "$msg_file")"

# Let git handle empty message errors.
if [[ -z "$message" ]]; then
  exit 0
fi

# Restrict to printable ASCII characters to keep message English-only.
if LC_ALL=C grep -q '[^ -~[:space:]]' <<<"$message"; then
  cat >&2 <<'ERR'
Commit rejected: commit message must be in English only.
Use Latin letters, numbers, spaces, and common punctuation.
ERR
  exit 1
fi

# Ensure there is at least one Latin letter in the message.
if ! grep -Eq '[A-Za-z]' <<<"$message"; then
  cat >&2 <<'ERR'
Commit rejected: commit message must contain English text.
ERR
  exit 1
fi
